// ADD TEXT
import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatefulWidget {
  @override
  State<MyApp> createState() => _MyAppState();
}

class _MyAppState extends State<MyApp> {
  String message = "Welcome";

  void changeMessage(String text) {
    setState(() {
      message = text;
    });
  }

  void feedback(BuildContext context) {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text("Feedback"),
          content: const TextField(
            decoration: InputDecoration(
              hintText: "Enter feedback",
              border: OutlineInputBorder(),
            ),
            maxLines: 1,
          ),
          actions: [
            ElevatedButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: const Text("Submit"),
            ),
          ],
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Builder(
        builder: (BuildContext context) {
          double width = MediaQuery.of(context).size.width;

          return Scaffold(
            appBar: AppBar(
              title: const Text("Responsive UI"),
            ),

            drawer: Drawer(
              child: ListView(
                children: [
                  const DrawerHeader(
                    decoration: BoxDecoration(
                      color: Colors.red,
                    ),
                    child: Text(
                      "Menu",
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 25,
                      ),
                    ),
                  ),

                  // Home
                  ListTile(
                    leading: const Icon(Icons.home),
                    title: const Text("Home"),
                    onTap: () {
                      changeMessage("Welcome to Home");
                      Navigator.pop(context);
                    },
                  ),

                  // Messages
                  ListTile(
                    leading: const Icon(Icons.message),
                    title: const Text("Messages"),
                    onTap: () {
                      changeMessage("Welcome to Messages");
                      Navigator.pop(context);
                    },
                  ),

                  // Photos
                  ListTile(
                    leading: const Icon(Icons.photo),
                    title: const Text("Photos"),
                    onTap: () {
                      changeMessage("Welcome to Photos");
                      Navigator.pop(context);
                    },
                  ),

                  // Feedback
                  ListTile(
                    leading: const Icon(Icons.feedback),
                    title: const Text("Feedback"),
                    onTap: () {
                      Navigator.pop(context);
                      feedback(context);
                    },
                  ),
                ],
              ),
            ),

            body: Center(
              child: width < 600
                  ? Column(
                      children: [
                        Text(
                          message,
                          style: const TextStyle(
                            fontSize: 25,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        Expanded(
                          child: Image.network(
                            'https://images.unsplash.com/photo-1635805737707-575885ab0820',
                            width: double.infinity,
                            fit: BoxFit.cover,
                          ),
                        ),
                      ],
                    )
                  : width < 900
                      ? Column(
                          children: [
                            Text(
                              message,
                              style: const TextStyle(
                                fontSize: 25,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                            Expanded(
                              child: Image.network(
                                'https://images.unsplash.com/photo-1635805737707-575885ab0820',
                                width: double.infinity,
                                fit: BoxFit.cover,
                              ),
                            ),
                          ],
                        )
                      : Row(
                          children: [
                            Expanded(
                              child: Image.network(
                                'https://images.unsplash.com/photo-1635805737707-575885ab0820',
                                fit: BoxFit.cover,
                              ),
                            ),
                            Expanded(
                              child: Center(
                                child: Text(
                                  message,
                                  style: const TextStyle(
                                    fontSize: 25,
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                              ),
                            ),
                          ],
                        ),
            ),
          );
        },
      ),
    );
  }
}
